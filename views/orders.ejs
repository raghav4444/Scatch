<%- include('./partials/header') %>

<% if (typeof success !== 'undefined' && success && success.length > 0) { %>
<div class="fixed top-24 left-1/2 -translate-x-1/2 z-[70] px-6 py-3 rounded-full glass-soft border border-emerald-500/30 shadow-[0_0_20px_rgba(16,185,129,0.15)]">
    <span class="inline-flex items-center gap-2 text-emerald-300 text-[10px] uppercase tracking-[0.2em] font-bold">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <%= success %>
    </span>
</div>
<% } %>

<% if (typeof error !== 'undefined' && error && error.length > 0) { %>
<div class="fixed top-24 left-1/2 -translate-x-1/2 z-[70] px-6 py-3 rounded-full glass-soft border border-red-500/30 shadow-[0_0_20px_rgba(239,68,68,0.15)]">
    <span class="inline-flex items-center gap-2 text-red-300 text-[10px] uppercase tracking-[0.2em] font-bold">
        <span class="w-1.5 h-1.5 rounded-full bg-red-400"></span>
        <%= error %>
    </span>
</div>
<% } %>

<%
    function statusTone(status) {
        if (status === 'delivered') return 'text-emerald-300 border-emerald-500/30 bg-emerald-500/10';
        if (status === 'out for delivery') return 'text-cyan-300 border-cyan-500/30 bg-cyan-500/10';
        if (status === 'shipped') return 'text-sky-300 border-sky-500/30 bg-sky-500/10';
        if (status === 'cancelled') return 'text-red-300 border-red-500/30 bg-red-500/10';
        return 'text-amber-300 border-amber-500/30 bg-amber-500/10';
    }
%>

<main class="mx-auto w-full max-w-7xl pt-24 md:pt-28 pb-20 px-5 md:px-10 min-h-[calc(100vh-80px)] text-white relative z-10">
    <div class="mb-8 md:mb-10 flex flex-wrap items-end justify-between gap-4">
        <div>
            <p class="text-[10px] uppercase tracking-[0.35em] text-zinc-500 font-bold mb-2">Purchase history</p>
            <h1 class="font-display text-3xl md:text-5xl tracking-[-0.03em] text-white">Your Orders</h1>
        </div>
        <a href="/shop" class="inline-flex items-center gap-2 rounded-full border border-white/20 px-5 py-2.5 text-[11px] uppercase tracking-[0.18em] font-bold hover:bg-white/10 transition">
            <i class="ri-store-2-line"></i> Shop more
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 md:gap-8">
        <aside class="lg:col-span-4">
            <div class="glass-soft rounded-[1.5rem] p-6 md:p-8 border border-white/10 space-y-4">
                <h3 class="text-lg md:text-xl font-semibold tracking-tight">Order analytics</h3>
                <div class="grid grid-cols-2 gap-3">
                    <div class="rounded-xl border border-white/10 bg-white/[0.03] p-4">
                        <p class="text-[10px] uppercase tracking-[0.18em] text-zinc-500 font-bold">Total</p>
                        <p class="mt-2 text-2xl font-semibold"><%= orders.length %></p>
                    </div>
                    <div class="rounded-xl border border-white/10 bg-white/[0.03] p-4">
                        <p class="text-[10px] uppercase tracking-[0.18em] text-zinc-500 font-bold">Delivered</p>
                        <p class="mt-2 text-2xl font-semibold"><%= statusCount.delivered || 0 %></p>
                    </div>
                    <div class="rounded-xl border border-white/10 bg-white/[0.03] p-4">
                        <p class="text-[10px] uppercase tracking-[0.18em] text-zinc-500 font-bold">In transit</p>
                        <p class="mt-2 text-2xl font-semibold"><%= (statusCount.shipped || 0) + (statusCount['out for delivery'] || 0) %></p>
                    </div>
                    <div class="rounded-xl border border-white/10 bg-white/[0.03] p-4">
                        <p class="text-[10px] uppercase tracking-[0.18em] text-zinc-500 font-bold">Processing</p>
                        <p class="mt-2 text-2xl font-semibold"><%= statusCount.processing || 0 %></p>
                    </div>
                </div>
                <a href="/profile" class="inline-flex items-center gap-2 rounded-full border border-white/20 px-5 py-2.5 text-[11px] uppercase tracking-[0.18em] font-bold hover:bg-white/10 transition">
                    <i class="ri-user-3-line"></i> Back to profile
                </a>
            </div>
        </aside>

        <section class="lg:col-span-8 space-y-4 md:space-y-5">
            <% if (!orders || !orders.length) { %>
                <div class="glass-soft rounded-[1.5rem] p-10 text-center border border-white/10">
                    <h2 class="text-2xl font-semibold tracking-tight">No orders yet</h2>
                    <p class="mt-3 text-zinc-400 text-sm">Your future purchases will appear here with delivery status.</p>
                </div>
            <% } else { %>
                <% orders.forEach(function(order){ %>
                    <article class="glass-soft rounded-[1.25rem] md:rounded-[1.5rem] p-5 md:p-6 border border-white/10">
                        <div class="flex flex-wrap items-start justify-between gap-3">
                            <div>
                                <p class="text-[10px] uppercase tracking-[0.18em] text-zinc-500 font-bold">Order ID</p>
                                <h3 class="mt-1 text-lg md:text-xl font-semibold tracking-tight"><%= order.orderCode %></h3>
                                <p class="mt-1 text-sm text-zinc-400">
                                    <% if (order.placedAt) { %>
                                        Placed on <%= new Date(order.placedAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                                    <% } else { %>
                                        Date unavailable
                                    <% } %>
                                </p>
                            </div>
                            <span class="inline-flex items-center rounded-full px-3 py-1 text-[10px] uppercase tracking-[0.18em] font-bold border <%= statusTone(order.status) %>">
                                <%= order.status %>
                            </span>
                        </div>

                        <div class="mt-5 grid grid-cols-1 sm:grid-cols-3 gap-3">
                            <div class="rounded-xl border border-white/10 bg-white/[0.03] p-3.5">
                                <p class="text-[10px] uppercase tracking-[0.18em] text-zinc-500 font-bold">Amount</p>
                                <p class="mt-2 text-lg font-semibold">₹<%= Math.round(order.amount || 0) %></p>
                            </div>
                            <div class="rounded-xl border border-white/10 bg-white/[0.03] p-3.5">
                                <p class="text-[10px] uppercase tracking-[0.18em] text-zinc-500 font-bold">Items</p>
                                <p class="mt-2 text-lg font-semibold"><%= order.itemCount %></p>
                            </div>
                            <div class="rounded-xl border border-white/10 bg-white/[0.03] p-3.5">
                                <p class="text-[10px] uppercase tracking-[0.18em] text-zinc-500 font-bold">Payment</p>
                                <p class="mt-2 text-lg font-semibold"><%= order.payment %></p>
                            </div>
                        </div>
                    </article>
                <% }); %>
            <% } %>
        </section>
    </div>
</main>

<%- include('./partials/footer') %>

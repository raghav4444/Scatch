<%- include('./partials/header') %>

    <% if(typeof success !=='undefined' && success.length>0){ %>
        <div
            class="fixed top-24 left-1/2 -translate-x-1/2 z-[70] px-6 py-3 rounded-full glass-soft border border-emerald-500/30 shadow-[0_0_20px_rgba(16,185,129,0.15)]">
            <span
                class="inline-flex items-center gap-2 text-emerald-300 text-[10px] uppercase tracking-[0.2em] font-bold">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <%= success %>
            </span>
        </div>
        <% } %>

            <% if(typeof error !=='undefined' && error && error.length>0){ %>
                <div
                    class="fixed top-24 left-1/2 -translate-x-1/2 z-[70] px-6 py-3 rounded-full glass-soft border border-red-500/30 shadow-[0_0_20px_rgba(239,68,68,0.15)]">
                    <span
                        class="inline-flex items-center gap-2 text-red-300 text-[10px] uppercase tracking-[0.2em] font-bold">
                        <span class="w-1.5 h-1.5 rounded-full bg-red-400"></span>
                        <%= error %>
                    </span>
                </div>
                <% } %>

                    <main
                        class="w-full min-h-screen pt-28 md:pt-36 pb-20 px-5 md:px-12 lg:px-20 relative z-10 text-white">

                        <section
                            class="mb-12 md:mb-16 scroll-reveal border border-white/10 rounded-[2rem] p-6 md:p-10 bg-gradient-to-br from-white/[0.08] via-white/[0.03] to-transparent backdrop-blur-xl shadow-[0_30px_80px_rgba(0,0,0,0.45)]">
                            <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8">
                                <div>
                                    <span class="text-[10px] uppercase tracking-[0.35em] text-zinc-400 font-bold block mb-3">
                                        Premium Collection
                                    </span>
                                    <h1
                                        class="text-3xl md:text-5xl lg:text-6xl font-semibold tracking-[-0.04em] text-white leading-[1.05]">
                                        Curated Essentials For
                                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-white to-zinc-400">Modern Living</span>
                                    </h1>
                                    <p class="mt-4 text-sm md:text-base text-zinc-400 max-w-2xl leading-relaxed">
                                        Discover elevated pieces designed with premium materials, timeless silhouettes, and unmatched comfort.
                                    </p>
                                </div>

                                <div class="grid grid-cols-3 gap-3 w-full lg:w-auto">
                                    <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-4 text-center">
                                        <p class="text-[10px] uppercase tracking-[0.2em] text-zinc-500 font-bold">Products</p>
                                        <p class="mt-2 text-xl font-semibold text-white"><%= (products || []).length %></p>
                                    </div>
                                    <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-4 text-center">
                                        <p class="text-[10px] uppercase tracking-[0.2em] text-zinc-500 font-bold">Shipping</p>
                                        <p class="mt-2 text-xl font-semibold text-white">24/7</p>
                                    </div>
                                    <div class="rounded-2xl border border-white/10 bg-white/[0.04] p-4 text-center">
                                        <p class="text-[10px] uppercase tracking-[0.2em] text-zinc-500 font-bold">Quality</p>
                                        <p class="mt-2 text-xl font-semibold text-white">A+</p>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <div class="flex flex-col lg:flex-row items-start gap-10">

                            <!-- Sidebar -->
                            <aside
                                class="w-full lg:w-1/4 lg:sticky top-32 rounded-[2rem] p-6 md:p-7 border border-white/10 bg-gradient-to-b from-[#0d1632]/90 to-[#050812]/95 backdrop-blur-xl scroll-reveal delay-100 shadow-[0_20px_50px_rgba(0,0,0,0.4)]">
                                <div class="flex flex-col gap-10 w-full">

                                    <!-- Sort -->
                                    <div class="w-full">
                                        <h3
                                            class="text-[10px] uppercase tracking-[0.35em] text-zinc-500 font-bold mb-6 flex items-center gap-3">
                                            <span class="w-1.5 h-1.5 rounded-full bg-zinc-500"></span> Sort By
                                        </h3>
                                        <form action="/shop" class="w-full relative group">
                                            <select
                                                class="w-full bg-white/5 border border-white/15 rounded-xl px-5 py-4 text-zinc-200 focus:outline-none focus:border-white/40 cursor-pointer text-[10px] appearance-none uppercase tracking-[0.2em] font-bold transition-all hover:bg-white/[0.08]"
                                                name="sortby" onchange="this.form.submit()">
                                                <option value="popular" class="bg-zinc-900">Popularity Rank</option>
                                                <option value="newest" class="bg-zinc-900">Latest Edition</option>
                                            </select>
                                            <i
                                                class="ri-arrow-down-s-line absolute right-5 top-1/2 -translate-y-1/2 text-zinc-500 pointer-events-none group-hover:text-white transition-colors"></i>
                                        </form>
                                    </div>

                                    <!-- Collections -->
                                    <div class="w-full">
                                        <h3
                                            class="text-[10px] uppercase tracking-[0.35em] text-zinc-500 font-bold mb-6 flex items-center gap-3">
                                            <span class="w-1.5 h-1.5 rounded-full bg-zinc-500"></span> Collections
                                        </h3>
                                        <div class="flex flex-col gap-4">
                                            <a class="text-zinc-300 text-[11px] uppercase tracking-[0.2em] font-bold hover:text-white transition-all flex items-center justify-between group"
                                                href="/shop">
                                                <span>All Products</span>
                                                <i
                                                    class="ri-arrow-right-s-line opacity-0 group-hover:opacity-100 transition-all -translate-x-2 group-hover:translate-x-0"></i>
                                            </a>
                                            <a class="text-zinc-400 text-[11px] uppercase tracking-[0.2em] font-bold hover:text-cyan-300 transition-all flex items-center justify-between group"
                                                href="/new-collection">
                                                <span>New Arrivals</span>
                                                <i
                                                    class="ri-arrow-right-s-line opacity-0 group-hover:opacity-100 transition-all -translate-x-2 group-hover:translate-x-0"></i>
                                            </a>
                                            <a class="text-zinc-400 text-[11px] uppercase tracking-[0.2em] font-bold hover:text-emerald-300 transition-all flex items-center justify-between group"
                                                href="/discounted-products">
                                                <span>Reserve & Sale</span>
                                                <i
                                                    class="ri-arrow-right-s-line opacity-0 group-hover:opacity-100 transition-all -translate-x-2 group-hover:translate-x-0"></i>
                                            </a>
                                        </div>
                                    </div>

                                    <div class="pt-6 border-t border-white/10">
                                        <div class="rounded-2xl border border-white/10 bg-white/[0.03] p-4">
                                            <p class="text-[9px] font-bold uppercase tracking-[0.22em] text-zinc-500 mb-2">Premium Promise</p>
                                            <p class="text-xs text-zinc-400 leading-relaxed">
                                                Handpicked products, secure checkout, and reliable shipping for every order.
                                            </p>
                                        </div>
                                    </div>

                                </div>
                            </aside>

                            <!-- Products Grid -->
                            <div
                                class="w-full lg:w-3/4 grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5 md:gap-7">
                                <% const fallbackImages = [
                                    "https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=800&h=1000&fit=crop",
                                    "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=800&h=1000&fit=crop",
                                    "https://images.unsplash.com/photo-1583394838336-acd977736f90?w=800&h=1000&fit=crop",
                                    "https://images.unsplash.com/photo-1503341455253-b2e723bb3dbb?w=800&h=1000&fit=crop",
                                    "https://images.unsplash.com/photo-1512436991641-6745cdb1723f?w=800&h=1000&fit=crop",
                                    "https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?w=800&h=1000&fit=crop"
                                ]; %>
                                <% (products || []).forEach(function(product, index){ %>
                                    <% const originalPrice = Number(product.price) || 0; %>
                                    <% const discountAmount = Number(product.discount) || 0; %>
                                    <% const validDiscount = discountAmount > 0 && discountAmount < originalPrice; %>
                                    <% const finalPrice = validDiscount ? (originalPrice - discountAmount) : originalPrice; %>
                                    <% const discountPercent = validDiscount ? Math.round((discountAmount / originalPrice) * 100) : 0; %>
                                    <% const rating = 4 + ((index % 10) / 10); %>
                                    <% const reviewCount = 30 + (index * 9); %>
                                    <% const fallbackImage = fallbackImages[index % fallbackImages.length]; %>
                                    <% const imageSrc = product.image ? ("data:image/jpeg;base64," + product.image.toString("base64")) : fallbackImage; %>
                                    <div class="scroll-reveal delay-<%= Math.min((index%3)*100, 300) %>">
                                        <article
                                            class="product-reveal-card group relative overflow-hidden rounded-[1.5rem] border border-white/10 bg-gradient-to-b from-white/[0.07] to-white/[0.03] backdrop-blur-xl shadow-[0_14px_30px_rgba(0,0,0,0.35)] transition-all duration-500 hover:-translate-y-1 hover:shadow-[0_30px_60px_rgba(0,0,0,0.5)]">
                                            <div class="relative overflow-hidden rounded-t-[1.5rem]">
                                                <img src="<%= imageSrc %>" alt="<%= product.name %>"
                                                    class="h-64 md:h-72 w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" />
                                                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>

                                                <button type="button"
                                                    class="favorite-btn absolute top-4 right-4 p-2 rounded-full backdrop-blur-sm border border-white/20 bg-black/30 text-white hover:bg-black/45 transition"
                                                    aria-label="Add to favorites">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                                        class="w-4 h-4 favorite-heart">
                                                        <path
                                                            d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.74 0-3.41.81-4.5 2.09A6 6 0 0 0 7.5 3 5.5 5.5 0 0 0 2 8.5C2 10.79 3.51 12.54 5 14l7 7Z">
                                                        </path>
                                                    </svg>
                                                </button>

                                                <% if(validDiscount) { %>
                                                    <div
                                                        class="absolute top-4 left-4 bg-red-500 text-white px-3 py-1 rounded-full text-[10px] uppercase tracking-[0.15em] font-black">
                                                        <%= discountPercent %>% OFF
                                                    </div>
                                                    <% } %>

                                                <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between text-xs">
                                                    <span class="bg-black/45 border border-white/15 backdrop-blur-sm px-3 py-1 rounded-full text-zinc-200">Premium Pick</span>
                                                    <span class="text-zinc-200 font-semibold">In Stock</span>
                                                </div>
                                            </div>

                                            <div class="p-5 space-y-3 relative z-10">
                                                <div class="flex items-center gap-2">
                                                    <div class="flex items-center gap-1">
                                                        <% for(let i = 0; i < 5; i++) { %>
                                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                                stroke-width="2" stroke-linecap="round"
                                                                stroke-linejoin="round"
                                                                class="w-4 h-4 <%= i < Math.floor(rating) ? 'text-yellow-400 fill-yellow-400/90' : 'text-zinc-600' %>">
                                                                <polygon
                                                                    points="12 2 15.1 8.3 22 9.3 17 14.2 18.2 21 12 17.7 5.8 21 7 14.2 2 9.3 8.9 8.3 12 2">
                                                                </polygon>
                                                            </svg>
                                                            <% } %>
                                                    </div>
                                                    <span class="text-xs text-zinc-400">
                                                        <%= rating.toFixed(1) %> (<%= reviewCount %> reviews)
                                                    </span>
                                                </div>

                                                <div class="space-y-2">
                                                    <h3 class="text-white text-lg font-semibold leading-tight tracking-tight">
                                                        <%= product.name %>
                                                    </h3>
                                                    <div class="flex items-center gap-2">
                                                        <span class="text-xl md:text-2xl font-bold text-white">₹<%= finalPrice %></span>
                                                        <% if(validDiscount) { %>
                                                            <span class="text-sm text-zinc-500 line-through">₹<%= originalPrice %></span>
                                                            <% } %>
                                                    </div>
                                                </div>

                                                <div class="flex items-center gap-2 pt-1">
                                                    <a href="/add-to-cart/<%= product._id %>"
                                                        class="flex-1 h-11 rounded-xl bg-white text-black font-semibold text-sm flex items-center justify-center gap-2 hover:bg-zinc-200 transition">
                                                        <i class="ri-shopping-bag-3-line"></i>
                                                        Add to Cart
                                                    </a>
                                                    <a href="/shop"
                                                        class="h-11 px-4 rounded-xl border border-white/20 text-white text-sm font-medium flex items-center justify-center hover:bg-white/10 transition">
                                                        <i class="ri-eye-line"></i>
                                                    </a>
                                                </div>
                                            </div>

                                            <div
                                                class="product-reveal-overlay absolute inset-x-0 top-0 h-64 md:h-72 bg-[#050505ea] backdrop-blur-xl flex flex-col justify-end translate-y-full opacity-0 transition-all duration-500">
                                                <div class="p-5 space-y-4">
                                                    <div>
                                                        <h4 class="font-semibold mb-2 text-white">Quick Overview</h4>
                                                        <p class="text-sm text-zinc-300 leading-relaxed">
                                                            <%= product.description || "Premium crafted piece with a clean silhouette, durable materials, and all-day comfort for everyday wear." %>
                                                        </p>
                                                    </div>

                                                    <div class="grid grid-cols-2 gap-3 text-xs">
                                                        <div class="bg-white/5 rounded-lg p-2 text-center">
                                                            <div class="font-semibold text-white">Premium Build</div>
                                                            <div class="text-zinc-500">Long-lasting</div>
                                                        </div>
                                                        <div class="bg-white/5 rounded-lg p-2 text-center">
                                                            <div class="font-semibold text-white">Fast Shipping</div>
                                                            <div class="text-zinc-500">Nationwide</div>
                                                        </div>
                                                    </div>

                                                    <div class="space-y-3">
                                                        <a href="/add-to-cart/<%= product._id %>"
                                                            class="w-full h-11 rounded-xl bg-white text-black font-semibold flex items-center justify-center gap-2 hover:bg-zinc-200 transition">
                                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                                stroke-width="2" stroke-linecap="round"
                                                                stroke-linejoin="round" class="w-4 h-4">
                                                                <circle cx="8" cy="21" r="1"></circle>
                                                                <circle cx="19" cy="21" r="1"></circle>
                                                                <path d="M2.5 3h2l2.4 11.2a2 2 0 0 0 2 1.6h9.6a2 2 0 0 0 2-1.6L22 6H7.2">
                                                                </path>
                                                            </svg>
                                                            Add to Cart
                                                        </a>
                                                        <a href="/shop"
                                                            class="w-full h-10 rounded-xl border border-white/20 text-white font-medium flex items-center justify-center hover:bg-white/10 transition">
                                                            View Details
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </article>
                                    </div>
                                    <% }) %>

                                        <% if(!products || products.length===0) { %>
                                            <div class="col-span-full rounded-[2rem] p-16 text-center border border-white/10 bg-white/[0.03] backdrop-blur-xl">
                                                <h3 class="text-2xl font-semibold tracking-tight mb-3">No Products Found
                                                </h3>
                                                <p class="text-zinc-500 max-w-sm mx-auto text-sm">No products matched your current filters. Explore the full collection to discover premium picks.</p>
                                                <a href="/shop"
                                                    class="mt-8 btn-liquid inline-flex items-center justify-center rounded-full bg-white text-black px-8 py-3.5 text-[10px] font-bold uppercase tracking-[0.2em] hover:-translate-y-0.5 transition">Clear
                                                    Filters</a>
                                            </div>
                                            <% } %>

                            </div>
                        </div>
                    </main>

                    <script>
                        document.addEventListener("DOMContentLoaded", () => {
                            const observer = new IntersectionObserver((entries) => {
                                entries.forEach(entry => {
                                    if (entry.isIntersecting) {
                                        entry.target.classList.add('in-view');
                                    }
                                });
                            }, { threshold: 0.1 });
                            document.querySelectorAll('.scroll-reveal').forEach(el => observer.observe(el));

                            document.querySelectorAll('.product-reveal-card').forEach((card) => {
                                const overlay = card.querySelector('.product-reveal-overlay');
                                if (!overlay) return;

                                card.addEventListener('mouseenter', () => {
                                    overlay.classList.remove('translate-y-full', 'opacity-0');
                                    overlay.classList.add('translate-y-0', 'opacity-100');
                                });
                                card.addEventListener('mouseleave', () => {
                                    overlay.classList.add('translate-y-full', 'opacity-0');
                                    overlay.classList.remove('translate-y-0', 'opacity-100');
                                });
                            });

                            document.querySelectorAll('.favorite-btn').forEach((btn) => {
                                btn.addEventListener('click', (event) => {
                                    event.preventDefault();
                                    event.stopPropagation();
                                    btn.classList.toggle('bg-red-500');
                                    btn.classList.toggle('text-white');
                                    btn.classList.toggle('scale-110');
                                    const heart = btn.querySelector('.favorite-heart');
                                    if (heart) heart.classList.toggle('fill-current');
                                });
                            });
                        });
                    </script>

                    <%- include('./partials/footer') %>